# Kopiere diese Datei nach .env und trag die Werte selbst ein.
# Schlüssel gehören nie in den Chat, nie in ein Git-Repo, nie in eine Mail.
# Welche du brauchst, hängt vom Weg je Plattform in konfig/kanaele.toml ab.

# Upload-Post (TikTok, Pinterest, Threads, auf Wunsch Instagram), Modul S5, Lektion 1
UPLOAD_POST_KEY=
# der Profilname, den du bei Upload-Post angelegt hast
UPLOAD_POST_USER=

# Instagram über die eigene Meta-App, Modul S5, Lektion 2
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
# nur für medien_weg = "supabase"
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# YouTube, Modul S5, Lektion 3. Die Anmeldedaten selbst liegen in arbeit/youtube_client.json
YOUTUBE_KANAL_ID=

# nur für urteil.backend = "anthropic" in konfig/pipeline.toml (kostet je Aufruf)
ANTHROPIC_API_KEY=
