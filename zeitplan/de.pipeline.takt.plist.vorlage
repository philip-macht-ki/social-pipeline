<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>Label</key><string>de.pipeline.takt</string><key>StartInterval</key><integer>1200</integer><key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string><string>cd __REPO__ && PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin uv run pipeline tag --echt</string></array><key>StandardOutPath</key><string>__REPO__/arbeit/logs/takt.out.log</string><key>StandardErrorPath</key><string>__REPO__/arbeit/logs/takt.err.log</string></dict></plist>
